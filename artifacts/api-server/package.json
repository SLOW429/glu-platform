    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/bullmq": "^10.2.3",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "cache-manager": "^5.7.1",
